# Bee node URL where the GSOC channel is reachable.
# Any full/light Bee node that participates in the GSOC neighborhood works.
GSOC_BEE_URL=http://localhost:1633

# Mined GSOC resource ID (32-byte hex private key) — its public key's
# ethereum address is what gsocSubscribe keys off. Generate with the Bee
# gsoc-mining utility or reuse one shared with the channel you want to join.
GSOC_RESOURCE_ID=

# Topic identifier string used with Identifier.fromString(GSOC_TOPIC).
# Plain text works; pick a stable label for the channel.
GSOC_TOPIC=

# Optional knobs
# LOG_LEVEL=info          # debug | info | warn | error
# QUEUE_CONCURRENCY=1     # how many messages to process in parallel (1 = serialized)
