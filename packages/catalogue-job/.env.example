# Chain / ERC-8004 identity
PRIVATE_KEY=              # Wallet private key for on-chain queries
RPC_URL=                  # JSON-RPC endpoint (defaults to https://sepolia.base.org)
CHAIN=base-sepolia        # Chain identifier (base-sepolia | base | mainnet)

# Swarm / Bee node
BEE_API_URL=http://localhost:1633
BEE_POSTAGE_STAMP=        # 64-char hex postage batch ID
BEE_FEED_PK=              # Private key used to sign catalogue feed updates

# Catalogue feed
CATALOGUE=                # Feed topic string (plain text or 64-char hex); e.g. "catalogue"
