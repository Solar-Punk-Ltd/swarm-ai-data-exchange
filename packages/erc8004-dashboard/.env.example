# Chains offered in the header dropdown, as a comma list of chain ids.
# 84532 = Base Sepolia, 11142220 = Celo Sepolia. Omit for a single-chain build.
VITE_CHAIN_IDS=84532,11142220

# Default chain when the URL (?chain=) and the remembered choice say nothing. Defaults to 84532.
VITE_CHAIN_ID=84532

# EVM RPC endpoint per chain for reading ERC-8004 registry logs. Optional: defaults are
# https://base-sepolia-rpc.publicnode.com (84532) and https://forno.celo-sepolia.celo-testnet.org
# (11142220). Avoid https://sepolia.base.org, which rate-limits eth_getLogs ("-32016 over rate
# limit"); set a paid endpoint (Alchemy, Infura, etc.) if the defaults throttle you.
VITE_RPC_URL_84532=
VITE_RPC_URL_11142220=

# Legacy single-chain form: the RPC for VITE_CHAIN_ID when no suffixed variable is set.
VITE_RPC_URL=
