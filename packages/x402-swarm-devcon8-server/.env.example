# --- HTTP server ---
PORT=3000

# --- x402 payment ---
NETWORK=eip155:84532
FACILITATOR_URL=https://x402.org/facilitator
# verifyingContract for the EIP-712 PurchaseIntent domain
PURCHASE_INTENT_DOMAIN_CONTRACT=0xYourDomainContractAddress

# --- Bee / Swarm ---
BEE_API_URL=http://localhost:1633
POSTAGE_BATCH_ID=
# EOA address of the catalog feed signer — locates the catalog on Swarm
CATALOG_FEED_OWNER=
# Per-item state feed signer private key (hot key, written on each purchase)
ITEM_STATE_FEED_PK=

# --- Storage ---
# SQLite file for the nonce store + purchase records
DB_PATH=./data/store.db

# --- Revenue splitter (@solarpunk/contracts) ---
# This seller's RevenueSplitter clone. When set, a purchase whose advertised payTo is any other
# address is rejected before /settle: it would settle untaxed and earn no Proof-of-Purchase.
# Resolve it with the swarm-market-mcp `ensure_split_contract` tool. Leave blank to disable
# the guard (any payTo accepted).
SPLITTER_ADDRESS=

# --- Devcon8 voucher funding (REAL MONEY: Gnosis mainnet xBZZ + xDAI) ---
# Every settled purchase mints a fresh wallet, funds it with the amounts below, and returns
# the private key in the purchase response. The key is stored NOWHERE — sqlite records the
# address only. This funder must NOT be the testnet funder.
GIFT_RPC_URL=https://rpc.gnosischain.com
GIFT_CHAIN_ID=100
GIFT_FUNDER_PK=
# xBZZ token on Gnosis (16 decimals — not 18)
GIFT_XBZZ_ADDRESS=0xdBF3Ea6F5beE45c02255B2c26a16F300502F68da
GIFT_XBZZ_AMOUNT=0.001
GIFT_XDAI_AMOUNT=0.001
