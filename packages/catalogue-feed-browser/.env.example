PORT=3001
BEE_API_URL=http://localhost:1633

# Required for buying items (consumer EVM wallet private key — signs the PurchaseIntent
# EIP-712 message and the ERC-3009 transferWithAuthorization)
EVM_PRIVATE_KEY=0x...
# The same key pays on every chain, so it needs USDC on each chain it buys on (testnets:
# https://faucet.circle.com). No gas token is needed: the facilitator submits the transfer.

# Optional: RPC per payment rail, "<caip2>=<url>,...", used to read the payment token's EIP-712
# domain on the chain being paid. A rail without an entry uses viem's public default.
RPC_URLS=eip155:84532=https://base-sepolia-rpc.publicnode.com,eip155:11142220=https://forno.celo-sepolia.celo-testnet.org

# Optional: pre-fill the UI form with defaults.
# The catalog feed topic is the fixed protocol constant, so only the owner is needed.
DEFAULT_FEED_OWNER=
DEFAULT_PUBLISHER_URL=http://localhost:3000
