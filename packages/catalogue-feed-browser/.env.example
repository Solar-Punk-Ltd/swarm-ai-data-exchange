PORT=3001
BEE_API_URL=http://localhost:1633

# Required for buying items (consumer EVM wallet private key — signs the PurchaseIntent
# EIP-712 message and the ERC-3009 transferWithAuthorization)
EVM_PRIVATE_KEY=0x...

# Optional: pre-fill the UI form with defaults.
# The catalog feed topic is the fixed protocol constant, so only the owner is needed.
DEFAULT_FEED_OWNER=
DEFAULT_PUBLISHER_URL=http://localhost:3000
