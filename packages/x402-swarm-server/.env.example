# --- HTTP server ---
PORT=3000

# --- x402 payment ---
NETWORK=eip155:84532
FACILITATOR_URL=https://x402.org/facilitator
# verifyingContract for the EIP-712 PurchaseIntent domain
PURCHASE_INTENT_DOMAIN_CONTRACT=0xYourDomainContractAddress

# --- Bee / Swarm ---
BEE_API_URL=http://localhost:1633
POSTAGE_BATCH_ID=
# EOA address of the catalog feed signer — locates the catalog on Swarm
CATALOG_FEED_OWNER=
# Per-item state feed signer private key (hot key, written on each purchase)
ITEM_STATE_FEED_PK=

# --- Storage ---
# SQLite file for the nonce store + purchase records
DB_PATH=./data/store.db
