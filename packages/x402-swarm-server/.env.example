# --- HTTP server ---
PORT=3000

# --- x402 payment ---
# The default rail. Every map below is keyed by CAIP-2 network and may list further rails; a
# catalog item advertises whichever rails its payment[] carries.
NETWORK=eip155:84532
FACILITATOR_URL=https://x402.org/facilitator
# Per-rail facilitator overrides, "<caip2>=<url>,...". A rail without an entry uses
# FACILITATOR_URL; an item's own payment[].facilitator wins over both. Celo runs its own hosted
# facilitator: https://api.x402.sepolia.celo.org (testnet), https://api.x402.celo.org (mainnet).
FACILITATOR_URLS=eip155:11142220=https://api.x402.sepolia.celo.org
# API keys keyed by facilitator base URL, "<url>=<key>,...", sent as X-API-Key. Celo's facilitator
# gates /settle on one — create it at https://x402.celo.org. Keyed by URL so a key only ever goes
# to the host that issued it.
FACILITATOR_API_KEYS=
# RPC per rail, "<caip2>=<url>,...", used to read the payment token's EIP-712 domain. A rail
# without an entry uses viem's default public RPC for that chain.
RPC_URLS=eip155:84532=https://base-sepolia-rpc.publicnode.com,eip155:11142220=https://forno.celo-sepolia.celo-testnet.org
# verifyingContract for the EIP-712 PurchaseIntent domain
PURCHASE_INTENT_DOMAIN_CONTRACT=0xYourDomainContractAddress

# --- Bee / Swarm ---
BEE_API_URL=http://localhost:1633
POSTAGE_BATCH_ID=
# EOA address of the catalog feed signer — locates the catalog on Swarm
CATALOG_FEED_OWNER=
# Per-item state feed signer private key (hot key, written on each purchase)
ITEM_STATE_FEED_PK=

# --- Storage ---
# SQLite file for the nonce store + purchase records
DB_PATH=./data/store.db

# --- Revenue splitter (@solarpunk/contracts) ---
# This seller's RevenueSplitter clone per rail, "<caip2>=<address>,...". When set, a purchase on a
# rail whose advertised payTo is any other address — or on a rail with no clone listed here — is
# rejected before /settle: it would settle untaxed and earn no Proof-of-Purchase. The clones come
# from the swarm-market-mcp `register_agent` tool (one per configured factory). Leave blank to
# disable the guard (any payTo accepted).
SPLITTER_ADDRESSES=eip155:84532=0xYourBaseClone,eip155:11142220=0xYourCeloClone
# Legacy single-rail form, read only when SPLITTER_ADDRESSES is unset: the clone on NETWORK.
# SPLITTER_ADDRESS=
