{
  "compilerOptions": {
    "target": "ES2022",
    // node16 (matching x402-swarm-server / swarm-catalog) so package `exports` maps are honoured.
    // Classic "node" resolution walks past viem's .d.ts into ox's .ts sources, which skipLibCheck
    // does not cover, and typechecks a dependency's implementation.
    "module": "node16",
    "moduleResolution": "node16",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "**/*.spec.ts"]
}
