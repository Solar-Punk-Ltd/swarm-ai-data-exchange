# Bee node endpoint
BEE_API_URL=http://localhost:1633

# Catalog feed signer private key (cold key)
BEE_FEED_PK=

# Per-item state feed signer private key (hot key) — MUST differ from BEE_FEED_PK
ITEM_STATE_FEED_PK=

# Postage stamp batch ID for uploads
POSTAGE_BATCH_ID=

# EVM wallet private key used by register_agent to mint the ERC-8004 NFT and deploy the
# seller's RevenueSplitter clone. Must own the agent NFT to write registry metadata.
# Also required by any tool that transacts on-chain. Wallet must be funded on the target chain.
PRIVATE_KEY=

# ERC-8004 chain + RPC. Defaults come from src/constants.ts (base-sepolia). This is the identity
# chain: where the agent NFT lives and where the agent_splitter link is written.
# RPC_URL=
# ERC8004_CHAIN=base-sepolia

# Every ERC-8004 chain the seller registers on (comma list, adapter names). register_agent
# converges an identity on each, all sharing one Agent Card. ERC8004_CHAIN is always included
# first. Each chain's RPC comes from RPC_URLS (CAIP-2 keyed) below.
# ERC8004_CHAINS=base-sepolia,celo-sepolia

# RPC per payment rail, "<caip2>=<url>,...", for splitter reads and clone deploys on rails other
# than the identity chain (which uses RPC_URL). A rail without an entry uses viem's public default.
RPC_URLS=eip155:11142220=https://forno.celo-sepolia.celo-testnet.org

# --- Revenue splitter (@solarpunk/contracts) ---
# SplitterFactory per payment rail, "<caip2>=<address>,..." (see packages/contracts/deployments/).
# register_agent deploys the seller's clone on every rail listed here, and build_catalog resolves
# each payment[] entry's payTo to the clone on that entry's chainId. A listing on a rail with no
# factory here is rejected: nothing on that chain could collect the tax.
SPLITTER_FACTORY_ADDRESSES=eip155:84532=0xBaseSepoliaFactory,eip155:11142220=0xCeloSepoliaFactory
# Legacy single-rail form, read only when SPLITTER_FACTORY_ADDRESSES is unset: the factory on
# ERC8004_CHAIN.
# SPLITTER_FACTORY_ADDRESS=

# Seller address whose splitter receives listing payments. With both values set, build_catalog
# resolves payment[].payTo to this seller's clone, and rejects any listing that names a different
# payTo — settling elsewhere is untaxed and earns no Proof-of-Purchase.
AGENT_PAYMENT_ADDRESS=

# --- Buyer side (purchase_catalog_item) ---
# Wallet that signs the EIP-712 PurchaseIntent and the ERC-3009 USDC authorization. Needs USDC on
# every rail it will pay on (Circle faucet for testnets); no gas token — the facilitator pays gas.
BUYER_WALLET_PK=
# RPC per rail, "<caip2>=<url>,...", used to read the payment token's EIP-712 domain on the rail
# being paid. PAYMENT_RPC_URL is the single-rail fallback.
PAYMENT_RPC_URLS=eip155:84532=https://base-sepolia-rpc.publicnode.com,eip155:11142220=https://forno.celo-sepolia.celo-testnet.org
# PAYMENT_RPC_URL=
# Seller x402 base URL (with /v1) when a purchase call omits x402Endpoint.
X402_ENDPOINT=
