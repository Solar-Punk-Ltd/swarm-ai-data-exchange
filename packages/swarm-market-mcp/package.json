{
  "name": "swarm-market-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing Swarm AI marketplace catalog operations to LLM agents",
  "main": "dist/index.js",
  "bin": {
    "swarm-market-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "serve": "ts-node src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write ."
  },
  "license": "ISC",
  "dependencies": {
    "@solarpunk/erc8004-adapter": "workspace:*",
    "@solarpunk/swarm-catalog": "workspace:*",
    "@ethersphere/bee-js": "12.0.0",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "dotenv": "^17.2.3",
    "ethers": "^6.13.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
